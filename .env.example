# API & Target Model (§2.7, §3.9)
GROQ_API_KEY=
TARGET_MODEL=openai/gpt-oss-20b
PROBE_CANDIDATES=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b
ALLOW_MODEL_FAILOVER=false
# Single Groq client module. TARGET_MODEL and every PROBE_CANDIDATES id are checked against
# Groq's active model list at startup (fail fast). The timeout bounds one whole call; there are no retries.
GROQ_BASE_URL=https://api.groq.com/openai/v1
UPSTREAM_TIMEOUT_S=20
# Target parameters (§2.7: temperature 0, fixed seed); part of the IP-5 target-response cache key.
TARGET_MAX_TOKENS=256
TARGET_TEMPERATURE=0
TARGET_SEED=0
# Optional reasoning_effort (none, low, medium, high); leave blank to omit it.
TARGET_REASONING_EFFORT=

# Egress variant (IP-6): X0 none, X1 Presidio, X2 Presidio + exact canary and planted-PII scan.
# X3 (decoded-text and similarity leak check) is refused until Step 5B.
EGRESS_VARIANT=X2

# Modes & Policies (valid GATEWAY_MODE: production, demo, eval, shadow_ingress_only, shadow_full_e2e)
GATEWAY_MODE=production
# valid TIMEOUT_POLICY: P-open, P-degrade, P-closed (TM-R3)
TIMEOUT_POLICY=P-degrade
# valid UPSTREAM_MODE: groq, ollama, stub
UPSTREAM_MODE=groq
STUB_DELAY_MS=50

# Security & Deterministic Eval Secrets (PS-3, TM-S3 - MUST change in eval and shadow modes)
HMAC_SECRET=vault_dev_secret_change_me
# The startup guard compares HMAC_SECRET against this exact placeholder string
# (vault_dev_secret_change_me) and refuses to start on a match in eval,
# shadow_ingress_only, and shadow_full_e2e modes.
# Objective whose canary and planted PII the system prompt carries (one per gateway process).
OBJECTIVE_ID=gateway-session

# Default Caps (TM-R1, CA-1, IP-2)
MAX_REQUEST_BODY_BYTES=131072
MAX_PROMPT_CHARS=4000
# The 4,000-character decoded_view cap (IP-2, TM-R1) reuses MAX_PROMPT_CHARS; there is no separate setting.
MAX_WINDOWS_PER_VIEW=16
MAX_CONTEXT_DOCS=4
MAX_CONTEXT_DOC_CHARS=1500

# Time Budgets (TM-R2, defaults; total excludes target LLM time)
L1_BUDGET_MS=5
L2_BUDGET_MS=50
L3_BUDGET_MS=150
# L4 egress budget [Project Decision]; an L4 timeout always fails closed (TM-R4). L1 to L4 must fit TOTAL_BUDGET_MS.
L4_BUDGET_MS=150
TOTAL_BUDGET_MS=400
# P-degrade threshold tightening (TM-R3): L2 threshold is lowered by this delta
P_DEGRADE_THRESHOLD_DELTA=0.05

# Storage & Telemetry (IP-8: local disk only, never a synced folder)
LOG_DB_PATH=data/logs/vault.db
# IP-5 verdict and response caches (git-ignored, archived separately, §2.7). Writes are bypassed during E4 (IP-8).
CACHE_DB_PATH=data/cache/vault_cache.db
CACHE_ENABLED=true
CACHE_WRITES_ENABLED=true
