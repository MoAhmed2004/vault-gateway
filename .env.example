# API & Target Model (§2.7, §3.9)
GROQ_API_KEY=
TARGET_MODEL=openai/gpt-oss-20b
PROBE_CANDIDATES=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b
ALLOW_MODEL_FAILOVER=false
# Single Groq client module. TARGET_MODEL and every PROBE_CANDIDATES id are checked against
# Groq's active model list at startup (fail fast). The timeout bounds one whole call; there are no retries.
GROQ_BASE_URL=https://api.groq.com/openai/v1
UPSTREAM_TIMEOUT_S=20
# Target parameters (§2.7: temperature 0, fixed seed); part of the IP-5 target-response cache key.
TARGET_MAX_TOKENS=256
TARGET_TEMPERATURE=0
TARGET_SEED=0
# Optional reasoning_effort (none, low, medium, high); leave blank to omit it.
TARGET_REASONING_EFFORT=

# Egress variant (IP-6, §2.1): X0 none, X1 Presidio, X2 Presidio + exact canary and planted-PII scan,
# X3 X2 + decoded-text scan (NFKC, Cf strip, Base64/hex) + similarity and n-gram leak check against the system prompt.
EGRESS_VARIANT=X2
# X3 leak check thresholds (O1 oracle defaults, §3.1): MiniLM cosine and share of system-prompt word n-grams.
X3_SIMILARITY_THRESHOLD=0.80
X3_NGRAM_OVERLAP_THRESHOLD=0.30
X3_NGRAM_SIZE=3

# Ingress layers (IP-3). Fetch the pinned model artifacts first: python scripts/fetch_models.py
# L2 threat memory: MiniLM ONNX embeddings against the active ChromaDB collection version
# (build the first version with: python scripts/build_l2_collection.py --input data/l2_seed/bootstrap.jsonl).
L2_ENABLED=true
# eval and both shadow tiers refuse an active L2 version labelled bootstrap (or descending from it): dev seed only.
MINILM_MODEL_DIR=models/minilm
CHROMA_DB_PATH=data/chroma_db
L2_THRESHOLD=0.80
# L3 semantic classifier: DeBERTa ONNX export (off-the-shelf by default; point at a fine-tuned export to swap).
L3_ENABLED=true
L3_MODEL_DIR=models/deberta
L3_MALICIOUS_LABEL=INJECTION
L3_THRESHOLD=0.50

# Bounded layer threadpool (IP-7): 0 workers means one per physical core; a full queue sheds load with the uniform 503.
LAYER_POOL_WORKERS=0
LAYER_POOL_QUEUE_LIMIT=32

# Modes & Policies (valid GATEWAY_MODE: production, demo, eval, shadow_ingress_only, shadow_full_e2e)
GATEWAY_MODE=production
# valid TIMEOUT_POLICY: P-open, P-degrade, P-closed (TM-R3)
TIMEOUT_POLICY=P-degrade
# valid UPSTREAM_MODE: groq, ollama, stub
UPSTREAM_MODE=groq
STUB_DELAY_MS=50

# Security & Deterministic Eval Secrets (PS-3, TM-S3 - MUST change in eval and shadow modes)
HMAC_SECRET=vault_dev_secret_change_me
# The startup guard compares HMAC_SECRET against this exact placeholder string
# (vault_dev_secret_change_me) and refuses to start on a match in eval,
# shadow_ingress_only, and shadow_full_e2e modes.
# Objective whose canary and planted PII the system prompt carries (one per gateway process).
OBJECTIVE_ID=gateway-session

# Default Caps (TM-R1, CA-1, IP-2)
MAX_REQUEST_BODY_BYTES=131072
MAX_PROMPT_CHARS=4000
# The 4,000-character decoded_view cap (IP-2, TM-R1) reuses MAX_PROMPT_CHARS; there is no separate setting.
MAX_WINDOWS_PER_VIEW=16
MAX_CONTEXT_DOCS=4
MAX_CONTEXT_DOC_CHARS=1500

# Time Budgets (TM-R2, defaults; total excludes target LLM time). Enforced in production, demo and eval only:
# both shadow tiers run every layer with no TM-R2 cut-off (30 s hang ceiling) and log the true latency (IP-4).
# TOTAL_BUDGET_MS is checked at startup against L1+L2+L3+L4; the InspectionBundle build is outside it.
L1_BUDGET_MS=5
L2_BUDGET_MS=50
L3_BUDGET_MS=150
# L4 egress budget [Project Decision]; an L4 timeout always fails closed (TM-R4). L1 to L4 must fit TOTAL_BUDGET_MS.
L4_BUDGET_MS=150
TOTAL_BUDGET_MS=400
# P-degrade threshold tightening (TM-R3): L2 threshold is lowered by this delta
P_DEGRADE_THRESHOLD_DELTA=0.05

# Storage & Telemetry (IP-8: local disk only, never a synced folder)
LOG_DB_PATH=data/logs/vault.db
# IP-5 verdict and response caches (git-ignored, archived separately, §2.7).
# Experiment E4 (TM-R5 load and timeout induction) runs with CACHE_ENABLED=false: no cache reads or writes,
# so every request runs every layer under load and no cached verdict hides a timeout (IP-8).
# shadow_full_e2e needs CACHE_ENABLED=true and CACHE_WRITES_ENABLED=true: it writes X0 to X3 to the egress
# cache for the harness oracle join (IP-4, IP-5).
CACHE_DB_PATH=data/cache/vault_cache.db
CACHE_ENABLED=true
CACHE_WRITES_ENABLED=true
